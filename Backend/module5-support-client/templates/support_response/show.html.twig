{% extends 'base.html.twig' %}

{% block title %}SupportResponse{% endblock %}

{% block body %}
    <h1>SupportResponse</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ support_response.id }}</td>
            </tr>
            <tr>
                <th>Contenu</th>
                <td>{{ support_response.contenu }}</td>
            </tr>
            <tr>
                <th>Auteur</th>
                <td>{{ support_response.auteur }}</td>
            </tr>
            <tr>
                <th>DateReponse</th>
                <td>{{ support_response.dateReponse ? support_response.dateReponse|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_support_response_index') }}">back to list</a>

    <a href="{{ path('app_support_response_edit', {'id': support_response.id}) }}">edit</a>

    {{ include('support_response/_delete_form.html.twig') }}
{% endblock %}
