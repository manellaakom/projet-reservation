{
  "openapi": "3.0.1",
  "info": {
    "title": "API Module 2 — Gestion, Recherche & Sécurité JWT des Voyages",
    "description": "Microservice dédié à la gestion unique de l'entité Voyage : CRUD complet, recherche multi-critères, filtres avancés, tri, comparateur d'offres, suggestions intelligentes, Feign, RabbitMQ et Sécurité JWT.",
    "contact": {
      "name": "Équipe Projet Réservation - Module 2",
      "email": "recherche@travel-reservation.tn"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8082",
      "description": "Serveur Local Direct (Port 8082)"
    },
    {
      "url": "http://localhost:8080",
      "description": "Via API Gateway (Port 8080)"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Sécurité & Authentification Keycloak / JWT",
      "description": "Gestion de l'authentification Keycloak (realm: travel-realm), génération de tokens et contrôle RBAC"
    },
    {
      "name": "Module 2 — Gestion & Recherche des Voyages",
      "description": "Microservice de gestion unique de l'entité Voyage : CRUD complet, recherche multi-critères, filtres, tri et suggestions"
    },
    {
      "name": "Communications Inter-Microservices (Feign & RabbitMQ)",
      "description": "Démonstrations des communications synchrones OpenFeign et asynchrones RabbitMQ (Note 4)"
    }
  ],
