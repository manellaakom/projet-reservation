    "/api/recherche/voyages": {
      "get": {
        "tags": ["Module 2 — Gestion & Recherche des Voyages"],
        "summary": "2. [READ ALL / SEARCH] Rechercher, filtrer et trier les voyages",
        "operationId": "rechercherVoyages",
        "parameters": [
          {"name": "motCle", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "villeDepart", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "villeDestination", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "paysDestination", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "compagnie", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "typeTransport", "in": "query", "required": false, "schema": {"type": "string", "enum": ["VOL","TRAIN","BUS","BATEAU","SEJOUR_PACK"]}},
          {"name": "categorie", "in": "query", "required": false, "schema": {"type": "string", "enum": ["ECONOMIQUE","CONFORT","PREMIUM","LUXE","PROMO"]}},
          {"name": "dateDepartMin", "in": "query", "required": false, "schema": {"type": "string", "format": "date"}},
          {"name": "dateDepartMax", "in": "query", "required": false, "schema": {"type": "string", "format": "date"}},
          {"name": "prixMin", "in": "query", "required": false, "schema": {"type": "number"}},
          {"name": "prixMax", "in": "query", "required": false, "schema": {"type": "number"}},
          {"name": "dureeMaxMinutes", "in": "query", "required": false, "schema": {"type": "integer", "format": "int32"}},
          {"name": "volDirectUniquement", "in": "query", "required": false, "schema": {"type": "boolean"}},
          {"name": "enPromotionUniquement", "in": "query", "required": false, "schema": {"type": "boolean"}},
          {"name": "bagageSouteInclus", "in": "query", "required": false, "schema": {"type": "boolean"}},
          {"name": "annulationGratuite", "in": "query", "required": false, "schema": {"type": "boolean"}},
          {"name": "placesMin", "in": "query", "required": false, "schema": {"type": "integer", "format": "int32"}},
          {"name": "noteMin", "in": "query", "required": false, "schema": {"type": "number", "format": "double"}},
          {"name": "sortBy", "in": "query", "required": false, "schema": {"type": "string", "default": "prix"}},
          {"name": "sortDir", "in": "query", "required": false, "schema": {"type": "string", "default": "asc"}}
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VoyageResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Module 2 — Gestion & Recherche des Voyages"],
        "summary": "1. [CREATE] Créer une nouvelle offre de voyage",
        "operationId": "creerVoyage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoyageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VoyageResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
